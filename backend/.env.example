# Variables de entorno de Academix - Plantilla
# Copio este archivo como .env y pongo los valores reales.
# El .env nunca se sube a Git por seguridad.

# Puerto donde corre el servidor
PORT=3000

# Ambiente de ejecucion: development | production | test
NODE_ENV=development

# URL de conexion a MySQL (Modulo 2 con Prisma)
DATABASE_URL="mysql://usuario:password@localhost:3306/academix"

# Secretos para firmar los JWT (Modulo 3)
# IMPORTANTE: en produccion deben ser cadenas largas y aleatorias.
JWT_ACCESS_SECRET=cambiame_en_produccion_access
JWT_REFRESH_SECRET=cambiame_en_produccion_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173