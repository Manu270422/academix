{
  "name": "academix-backend",
  "version": "1.0.0",
  "description": "API REST de Academix - Sistema de Gestion Academica. Proyecto SENA ADSO por Carlos Manuel Turizo Hernandez.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --clear src/server.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "start": "prisma migrate deploy && node dist/server.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "academix",
    "sena",
    "adso",
    "academico",
    "api"
  ],
  "author": "Carlos Manuel Turizo Hernandez",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "prisma": "5.22.0",
    "resend": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.5.4"
  }
}