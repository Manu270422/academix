// ============================================================
// SCHEMA DE PRISMA - ACADEMIX
// ============================================================
// Aqui defino la estructura completa de mi base de datos.
// Prisma lee este archivo y genera dos cosas a partir de el:
//   1. Las migraciones SQL para crear/modificar tablas en MySQL.
//   2. Un cliente TypeScript con tipos para hacer consultas seguras.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Estados posibles de una tarea (pendiente, en progreso, completada).
// Estos coinciden con la HU07 (cambio de estado de tareas).
enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

// Prioridad de la tarea: la anado como mejora a las HU originales
// para que el estudiante pueda priorizar visualmente sus pendientes.
enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

// De donde viene la identidad del usuario. LOCAL = se registro con
// email y contrasena normal. Los demas son login social: el usuario
// nunca puso contrasena, Google/Microsoft/Facebook confirman quien es.
enum ProveedorAuth {
  LOCAL
  GOOGLE
  MICROSOFT
  FACEBOOK
}

// ============================================================
// MODELO USUARIO
// ============================================================
// Representa al estudiante que usa Academix.
// Cumple con la HU01 (registro) y HU02 (inicio de sesion).
model Usuario {
  id Int @id @default(autoincrement())

  // El email es UNICO: no puede haber dos usuarios con el mismo email.
  email String @unique @db.VarChar(150)

  // Nombre completo del estudiante. Maximo 100 caracteres.
  nombre String @db.VarChar(100)

  // IMPORTANTE: aqui guardo el HASH de la contrasena, NUNCA la contrasena
  // en claro. Ahora es OPCIONAL: un usuario que entra por Google/Microsoft/
  // Facebook nunca crea contrasena, asi que este campo queda null para el.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  // De donde viene esta cuenta. Por defecto LOCAL (registro tradicional).
  proveedorAuth ProveedorAuth @default(LOCAL) @map("proveedor_auth")

  // El ID unico que el proveedor social le asigna a esta persona
  // (ej. el "sub" que manda Google). Lo uso para reconocer al usuario
  // en logins futuros, sin depender solo del email. Null para cuentas
  // LOCAL.
  proveedorId String? @map("proveedor_id") @db.VarChar(255)

  // Timestamps automaticos para auditoria y trazabilidad.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // RELACION: un usuario puede tener MUCHAS materias (1 a N).
  // El "onDelete: Cascade" significa que si borro un usuario,
  // automaticamente se borran todas sus materias (y por cascada sus tareas).
  materias Materia[]

  // RELACION: un usuario puede tener VARIAS suscripciones push (1 a N),
  // una por cada navegador/dispositivo donde activo las notificaciones
  // (ej. el celular y el computador).
  pushSubscriptions PushSubscription[]

  // Con esto evito que dos cuentas sociales del mismo proveedor
  // (ej. dos logins de Google) terminen apuntando al mismo proveedorId
  // por error. Cuando proveedorId es null (cuentas LOCAL), MySQL no
  // aplica la restriccion unica a esas filas, asi que no afecta el
  // registro tradicional.
  @@unique([proveedorAuth, proveedorId])
  @@map("usuarios")
}

// ============================================================
// MODELO MATERIA
// ============================================================
// Cumple con la HU03, HU04, HU05 (gestion de materias).
model Materia {
  id Int @id @default(autoincrement())

  nombre String @db.VarChar(100)

  // Color en formato hex (#RRGGBB) para identificar visualmente cada materia.
  color String? @db.VarChar(7)

  descripcion String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // BORRADO SUAVE: cuando el estudiante "elimina" una materia, no la
  // borro de verdad: le pongo aqui la fecha y la escondo de todas las
  // consultas normales. Va a la Papelera, desde donde se puede
  // restaurar o borrar definitivamente. Un cron la borra de verdad a
  // los 30 dias.
  deletedAt DateTime? @map("deleted_at")

  // RELACION: cada materia pertenece a UN usuario.
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // RELACION: una materia puede tener MUCHAS tareas (1 a N).
  tareas Tarea[]

  // RELACION: una materia puede tener MUCHAS notas (apuntes sueltos).
  notas Nota[]

  @@index([usuarioId])
  @@index([deletedAt])
  @@map("materias")
}

// ============================================================
// MODELO NOTA
// ============================================================
// Apuntes sueltos que el estudiante escribe sobre una materia
// ("clase del 3 de sep: repasar limites", "el profe dijo que el
// parcial es acumulativo", etc). No van dentro de una tarea: son
// de la materia en general.
model Nota {
  id Int @id @default(autoincrement())

  // Texto libre. La primera línea hace de "título" en la interfaz.
  contenido String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // RELACION: cada nota pertenece a UNA materia. Si se borra la
  // materia, se borran sus notas (cascade).
  materiaId Int     @map("materia_id")
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@index([materiaId])
  @@map("notas")
}

// ============================================================
// MODELO TAREA
// ============================================================
// Cumple con la HU06, HU07, HU08 (gestion de tareas).
model Tarea {
  id Int @id @default(autoincrement())

  titulo String @db.VarChar(200)

  descripcion String? @db.Text

  // Fecha y hora de entrega. Es OBLIGATORIA.
  fechaEntrega DateTime @map("fecha_entrega")

  // Estado actual de la tarea.
  estado EstadoTarea @default(PENDIENTE)

  prioridad Prioridad @default(MEDIA)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // BORRADO SUAVE: igual que en Materia. Al "eliminar" una tarea va a
  // la Papelera en vez de borrarse. Tambien se marca aqui cuando se
  // elimina su materia (para que la tarea siga a su materia).
  deletedAt DateTime? @map("deleted_at")

  // RELACION: cada tarea pertenece a UNA materia.
  materiaId Int     @map("materia_id")
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  // RELACION: cada tarea puede tener VARIOS recordatorios (1 a N),
  // uno por cada umbral de anticipacion (72h, 24h, 6h). Cambie esto
  // de 1:0..1 a 1:N para poder avisarle al estudiante varias veces
  // segun se acerca la fecha, en vez de un solo aviso.
  recordatorios Recordatorio[]

  // RELACION: una tarea puede tener VARIAS subtareas (1 a N). Es el
  // "checklist" para partir una entrega grande en pasos concretos
  // (ej. "Ensayo" -> leer, redactar, revisar bibliografia).
  subtareas Subtarea[]

  @@index([materiaId])
  @@index([fechaEntrega])
  @@index([estado])
  @@index([deletedAt])
  @@map("tareas")
}

// ============================================================
// MODELO SUBTAREA
// ============================================================
// Un paso concreto dentro de una tarea. El estudiante lo marca
// como hecho o no hecho. No tiene fecha ni prioridad propia: es
// solo una casilla del checklist de su tarea "padre".
model Subtarea {
  id Int @id @default(autoincrement())

  titulo String @db.VarChar(200)

  completada Boolean @default(false)

  // Posicion dentro del checklist, para poder mostrarlas y
  // reordenarlas en el orden que el estudiante quiera.
  orden Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // RELACION: cada subtarea pertenece a UNA tarea. Si se borra la
  // tarea, se borran sus subtareas (cascade).
  tareaId Int   @map("tarea_id")
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([tareaId])
  @@map("subtareas")
}

// ============================================================
// MODELO RECORDATORIO
// ============================================================
// Clase de apoyo que se encarga de avisarle al estudiante cuando
// una tarea esta por vencer. Separo esta responsabilidad de Tarea
// tal como quedo definido en el diagrama de clases (Fase 2).
//
// Cada tarea tiene VARIAS filas de Recordatorio (una por umbral:
// 72h, 24h, 6h antes de vencer - ver reminders.constants.ts). Cada
// una se envia y se marca de forma independiente.
model Recordatorio {
  id Int @id @default(autoincrement())

  // Cuantas horas antes de la fecha de entrega se debe avisar.
  anticipacionHoras Int @map("anticipacion_horas")

  // Controlo si ya se envio el correo, para no mandarlo dos veces.
  enviadoEmail    Boolean   @default(false) @map("enviado_email")
  fechaEnvioEmail DateTime? @map("fecha_envio_email")

  // Controlo si el estudiante ya vio la notificacion dentro de la app.
  leidoEnApp Boolean @default(false) @map("leido_en_app")

  // Cuento los intentos de envio fallidos. Maximo 3 (ver reminders.service.ts).
  intentosEnvio Int     @default(0) @map("intentos_envio")
  ultimoError   String? @map("ultimo_error") @db.Text

  // Cuando llega a 3 intentos fallidos, marco esto en true para que
  // el cron deje de intentar enviarlo en cada ciclo.
  fallidoDefinitivo Boolean @default(false) @map("fallido_definitivo")

  createdAt DateTime @default(now()) @map("created_at")

  // RELACION: cada recordatorio pertenece a UNA tarea.
  tareaId Int   @map("tarea_id")
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  // Con esto evito que la misma tarea tenga dos recordatorios con el
  // mismo umbral (ej. dos de "24 horas antes"). Ya no puede haber un
  // recordatorio unico por tarea (por eso tareaId dejo de ser @unique
  // solo), pero la COMBINACION tarea+umbral si debe ser unica.
  @@unique([tareaId, anticipacionHoras])
  @@map("recordatorios")
}

// ============================================================
// MODELO PUSHSUBSCRIPTION
// ============================================================
// Guardo aqui la "suscripcion" que el navegador del estudiante
// genera cuando acepta recibir notificaciones push (las que
// aparecen en la barra del sistema / pantalla de bloqueo). Con
// estos 3 datos (endpoint + las 2 llaves) le puedo mandar avisos
// a ese navegador especifico en cualquier momento, aunque el
// estudiante tenga Academix cerrado.
model PushSubscription {
  id Int @id @default(autoincrement())

  // La URL unica que identifica a este navegador/dispositivo ante
  // el servicio de push (Chrome, Firefox, etc). Es unica: si el
  // mismo navegador se vuelve a suscribir, actualizo en vez de
  // duplicar (ver push.service.ts, uso upsert).
  endpoint String @unique @db.VarChar(500)

  // Llaves de cifrado que exige el estandar Web Push para que el
  // contenido de la notificacion viaje encriptado.
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  // RELACION: cada suscripcion pertenece a UN usuario. Un usuario
  // puede tener varias (un dispositivo por cada uno).
  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("push_subscriptions")
}
